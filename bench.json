// ollama-bench configuration. // comments are allowed.
// Every field is optional; anything omitted falls back to the built-in default.
// Flags override this file: ollama-bench -config bench.json -models gemma4:latest
{
  "base_url": "http://localhost:11434",
  "request_timeout_sec": 1800,

  // Iterations per condition. 3 is the minimum for a usable median; the report
  // marks any cell whose spread exceeds 15% CV with "!".
  "repeat": 3,

  // Discarded request before each model, used only to measure cold load time.
  "warmup": true,

  // Unload between models so cold-load timing is honest and no model competes
  // for VRAM with the previous one.
  "unload_between_models": true,
  "cooldown_sec": 3,

  // Applied to every request. temperature 0 + a fixed seed keeps output length
  // stable so run-to-run differences are the server's, not the sampler's.
  "options": {
    "temperature": 0,
    "seed": 42
  },

  "models": [
    { "name": "ornith1.5:latest" }

    // Uncomment to benchmark several models in one pass:
    // ,{ "name": "qwen3.8:latest", "think": "low" }
    // ,{ "name": "gemma4:latest" }
    // ,{ "name": "qwen3-coder:latest" }
    // ,{ "name": "ornith:latest" }
    // ,{ "name": "llama3.2:1b" }

    // Per-model overrides are also allowed:
    // ,{ "name": "qwen3.8:latest", "think": "high", "options": { "num_ctx": 32768 } }
  ],

  "suites": ["latency", "prefill", "depth", "concurrency", "sanity", "accuracy", "tools"],

  // Short prompts. Measures TTFT and decode throughput.
  "latency": {
    "num_predict": 256,
    "prompts": [
      { "label": "story",     "text": "tell me a story about a frog and a princess" },
      { "label": "cpu-cache", "text": "explain how a CPU cache works" },
      { "label": "bash",      "text": "write a bash script that lists the 5 largest files in the current directory, sorted by size" },
      { "label": "tcp-udp",   "text": "what are the differences between TCP and UDP?" }
    ]
  },

  // Prompt-processing throughput vs prompt length. num_predict is tiny so
  // decode barely contributes. Targets above the model's num_ctx are skipped.
  "prefill": {
    "depths": [1000, 4000, 16000],
    "num_predict": 8
  },

  // Decode throughput with a filled KV cache. This is the curve that separates
  // long-context models on constrained hardware. Add 65536/131072 for the
  // 262k-context models, at the cost of a much longer run.
  "depth": {
    "depths": [0, 8000, 32000],
    "num_predict": 256
  },

  // Parallel streams. On a single-GPU host with OLLAMA_NUM_PARALLEL=1 requests
  // serialize and scaling stays flat, which is itself worth knowing.
  "concurrency": {
    "levels": [1, 2, 4],
    "num_predict": 128,
    "repeat": 1
  },

  // Cheap pass/fail so a model that benchmarks fast on garbage output is
  // obvious. Not a quality score.
  "sanity": {
    "num_predict": 2048
  },

  // 18 auto-graded tasks across six groups, run on the chat endpoint so a
  // thinking model is not scored on its own reasoning text. Thinking models
  // need a generous budget or they truncate mid-answer.
  "accuracy": {
    "num_predict": 2048
  },

  // Multi-turn tool calling: the pattern a coding agent drives. Catches
  // failures that single-shot code generation cannot see.
  "tools": {
    "num_predict": 2048
  }
}
